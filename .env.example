# Neon Postgres connection string (from neon.tech project)
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Admin login (Tsugi). Just a string identifier — email, phone, or anything.
ADMIN_USERNAME=tsugi@example.com

# Admin password — plaintext, simple, memorable.
# (No sensitive data behind this; it's a soft barrier to keep visitors from editing.)
ADMIN_PASSWORD=changeme

# Random 32+ char secret for cookie signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-32-plus-random-characters
