# Neon Postgres connection string (from neon.tech project)
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Public site URL used for social preview/canonical metadata.
# Optional on Vercel unless you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://goodminton.vercel.app

# Initial Tsugi migration values. New clubs register in the app.
TSUGI_CLUB_NAME=Tsugi club
TSUGI_ADMIN_NAME=Tsugi
TSUGI_ADMIN_PHONE=6282340732720

# Initial Tsugi admin password for migration.
ADMIN_PASSWORD=sugianto

# Random 32+ char secret for cookie signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-32-plus-random-characters
